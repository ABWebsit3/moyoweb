---
import { Image } from 'astro:assets';
import { IMAGES } from '../data/site';
// Jessica Da Veiga (jdeventandhomedesign.fr) est mise en avant : seul site client encore en ligne.
// ⚠ Capture Lucas Invest Immo à fournir (placeholder rayé en attendant).
---

<section id="projets" class="band projects">
  <div class="container projects__inner">
    <div class="section-head" data-reveal>
      <h2 class="h2">Made by Moyo</h2>
      <p class="projects__intro">Ils nous font confiance ! Quelques sites livrés récemment.</p>
    </div>
    <div class="projects__row" data-reveal-stagger>
      <a href="https://jdeventandhomedesign.fr/" class="project project--main" target="_blank" rel="noopener">
        <Image src={IMAGES.jd} alt="Site de Jessica Da Veiga, décoration événementielle" class="project__shot" widths={[700, 1400]} sizes="(min-width: 1240px) 790px, 100vw" />
        <div class="project__foot">
          <span style="display:flex;flex-direction:column;gap:2px">
            <span class="project__name" style="font-size:22px">Jessica Da Veiga</span>
            <span class="project__sub">Décoration événementielle</span>
          </span>
          <span class="project__link">Voir le site ↗</span>
        </div>
      </a>
      <div class="projects__side">
        <div class="project">
          <Image src={IMAGES.tkl} alt="Site TKL Miami" class="project__shot" widths={[400, 800]} sizes="(min-width: 900px) 400px, 100vw" />
          <div class="project__foot"><span class="project__name">TKL Miami</span></div>
        </div>
        <div class="project">
          <div class="project__placeholder" style="--a:#FFEBD1;--b:#FDDCB0;color:#9A5A0A">capture du site</div>
          <div class="project__foot"><span class="project__name">Lucas Invest Immo</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects { background: var(--green); }
  .projects__inner { padding-top: 88px; padding-bottom: 88px; display: flex; flex-direction: column; gap: 36px; }
  .projects__intro { margin: 0; font-size: 17px; font-weight: 600; max-width: 360px; }
  .projects__row { display: flex; flex-wrap: wrap; gap: 22px; }
  .projects__side { flex: 1 1 300px; display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  .project {
    flex: 1;
    min-width: 0;
    background: #fff;
    border: var(--border);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 6px 6px 0 var(--ink);
    display: flex;
    flex-direction: column;
    color: var(--ink);
  }
  .project--main {
    flex: 2 1 520px;
    text-decoration: none;
    transition: transform .12s, box-shadow .12s;
  }
  .project--main:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--ink); color: var(--ink); }
  .project :global(.project__shot) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; border-bottom: var(--border); }
  .project__foot { padding: 14px 20px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .project--main .project__foot { padding: 18px 22px; }
  .project__name { font-family: var(--font-display); font-weight: 800; font-size: 19px; }
  .project__link { font-weight: 700; font-size: 15px; }
  .project__placeholder {
    flex: 1;
    min-height: 150px;
    background: repeating-linear-gradient(135deg, var(--a) 0 10px, var(--b) 10px 20px);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    border-bottom: var(--border);
  }
  .project__sub { font-size: 14px; font-weight: 600; color: var(--muted); }
  /* Dans la colonne latérale, la capture remplit l'espace restant sans pousser le nom hors de la carte. */
  .projects__side .project :global(.project__shot) {
    flex: 1 1 0;
    min-height: 150px;
    aspect-ratio: auto;
    object-fit: cover;
    object-position: top;
  }
</style>
