---
import { Image } from 'astro:assets';
import { IMAGES } from '../data/site';
// Jessica Da Veiga (jdeventandhomedesign.fr) et Obaria (obaria.fr) sont mis en avant : sites clients en ligne.
const featured = [
  { href: 'https://jdeventandhomedesign.fr/', img: IMAGES.jd, name: 'Jessica Da Veiga', sub: 'Décoration événementielle', alt: 'Site de Jessica Da Veiga, décoration événementielle' },
  { href: 'https://www.obaria.fr/', img: IMAGES.obaria, name: 'Obaria', sub: 'Massages bien-être', alt: 'Site d’Obaria, massages bien-être' },
];
const others = [
  { img: IMAGES.tkl, name: 'TKL Miami', alt: 'Site TKL Miami' },
  { img: IMAGES.lucas, name: 'Lucas Invest Immo', alt: 'Site Lucas Invest Immo' },
];
---

<section id="projets" class="band projects">
  <div class="container projects__inner">
    <div class="section-head" data-reveal>
      <h2 class="h2">Made by Moyo</h2>
      <p class="projects__intro">Ils nous font confiance ! Quelques sites livrés récemment.</p>
    </div>
    <div class="projects__grid" data-reveal-stagger>
      {featured.map((p) => (
        <a href={p.href} class="project project--main" target="_blank" rel="noopener">
          <Image src={p.img} alt={p.alt} class="project__shot" widths={[640, 1280]} sizes="(min-width: 1240px) 590px, (min-width: 760px) 50vw, 100vw" />
          <div class="project__foot">
            <span style="display:flex;flex-direction:column;gap:2px">
              <span class="project__name" style="font-size:22px">{p.name}</span>
              <span class="project__sub">{p.sub}</span>
            </span>
            <span class="project__link">Voir le site ↗</span>
          </div>
        </a>
      ))}
      {others.map((p) => (
        <div class="project">
          <Image src={p.img} alt={p.alt} class="project__shot" widths={[640, 1280]} sizes="(min-width: 1240px) 590px, (min-width: 760px) 50vw, 100vw" />
          <div class="project__foot"><span class="project__name">{p.name}</span></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects { background: var(--green); }
  .projects__inner { padding-top: 88px; padding-bottom: 88px; display: flex; flex-direction: column; gap: 36px; }
  .projects__intro { margin: 0; font-size: 17px; font-weight: 600; max-width: 360px; }
  .projects__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  @media (max-width: 760px) { .projects__grid { grid-template-columns: 1fr; } }
  .project {
    min-width: 0;
    background: #fff;
    border: var(--border);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 6px 6px 0 var(--ink);
    display: flex;
    flex-direction: column;
    color: var(--ink);
  }
  .project--main {
    text-decoration: none;
    transition: transform .12s, box-shadow .12s;
  }
  .project--main:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--ink); color: var(--ink); }
  .project :global(.project__shot) { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; display: block; border-bottom: var(--border); }
  .project__foot { padding: 14px 20px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .project--main .project__foot { padding: 18px 22px; }
  .project__name { font-family: var(--font-display); font-weight: 800; font-size: 19px; }
  .project__link { font-weight: 700; font-size: 15px; }
  .project__sub { font-size: 14px; font-weight: 600; color: var(--muted); }
</style>
