---
import { Image } from 'astro:assets';
import { IMAGES } from '../data/site';

const perks = ['Avec ou sans engagement', 'En ligne en 3 à 5 jours', 'Dès 44,99 €/mois'];
---

<section class="container hero">
  <div class="hero__text">
    <div class="hero__badge">
      <span class="hero__badge-new">Nouveau</span>
      Ton site en ligne en 3 à 5 jours
    </div>
    <h1 class="h1">L’agence qui te crée un site… <span class="hl">sans te ruiner</span> d’un coup !</h1>
    <p class="hero__lead">
      Ton site web, livré clé en main, hébergé, sécurisé et mis à jour pour une petite mensualité. Tu profites, on s’occupe de tout.
    </p>
    <div class="hero__ctas">
      <a href="#devis" class="btn btn--violet">Calculer mon devis en 2 min</a>
      <a href="#concept" class="hero__link">Comment ça marche ?</a>
    </div>
    <ul class="hero__perks">
      {perks.map((p) => <li><span class="check-dot" aria-hidden="true">✓</span>{p}</li>)}
    </ul>
  </div>
  <div class="hero__visual">
    <div class="hero__blob" aria-hidden="true"></div>
    <div class="hero__dot" aria-hidden="true"></div>
    <Image src={IMAGES.transat} alt="Mo’ sur son petit transat" class="hero__img" loading="eager" fetchpriority="high" />
    <div class="hero__quote">
      <span class="display">“C’est le Netflix du site internet.”</span>
      <span class="hero__rating">★★★★★ 4,9/5 · 127 avis</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 56px;
    padding-bottom: 72px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 40px;
    align-items: center;
  }
  .hero__text { display: flex; flex-direction: column; gap: 26px; }
  .hero__badge {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 8px;
    background: var(--lilac);
    border: var(--border);
    border-radius: 999px;
    padding: 6px 14px 6px 8px;
    font-weight: 600;
    font-size: 14px;
  }
  .hero__badge-new {
    background: var(--green);
    border: var(--border);
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 12px;
    font-weight: 700;
  }
  .hero__lead {
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.5;
    margin: 0;
    max-width: 520px;
    text-wrap: pretty;
  }
  .hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .hero__link { color: var(--ink); font-weight: 700; font-size: 16px; padding: 14px 8px; }
  .hero__perks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 14px;
    font-weight: 600;
  }
  .hero__perks li { display: flex; align-items: center; gap: 6px; }
  .hero__visual {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 560px;
    width: 100%;
    justify-self: center;
  }
  .hero__blob {
    position: absolute;
    inset: 6% 0 0 8%;
    background: var(--orange);
    border: var(--border);
    border-radius: 46% 54% 38% 62% / 52% 40% 60% 48%;
  }
  .hero__dot {
    position: absolute;
    top: 2%;
    left: 0;
    width: 22%;
    aspect-ratio: 1;
    background: var(--green);
    border: var(--border);
    border-radius: 50%;
  }
  .hero__visual :global(.hero__img) {
    position: absolute;
    inset: 4% 2% 6% 6%;
    width: 92%;
    height: 90%;
    object-fit: contain;
  }
  .hero__quote {
    position: absolute;
    bottom: 4%;
    left: -2%;
    background: #fff;
    border: var(--border);
    border-radius: 16px;
    padding: 12px 16px;
    box-shadow: 4px 4px 0 var(--ink);
    display: flex;
    flex-direction: column;
    gap: 2px;
    transform: rotate(-3deg);
  }
  .hero__quote .display { font-size: 18px; }
  .hero__rating { font-size: 13px; color: var(--text-2); }
</style>
