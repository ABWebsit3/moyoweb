---
import { reviews } from '../data/site';
// ⚠ Note et avis fictifs (maquette) : à remplacer par les vrais avis Google.
---

<section class="container reviews">
  <div class="section-head">
    <h2 class="h2"><span class="hl hl--green">Ils en parlent mieux que nous</span></h2>
    <div class="reviews__score">
      <span class="display" style="font-size:34px">4,9/5</span>
      <span class="reviews__count">★★★★★ note moyenne</span>
    </div>
  </div>
  <div class="grid-auto" style="--min:300px" data-reveal-stagger>
    {reviews.map((r) => (
      <figure class="card review" style={`background:${r.bg};transform:rotate(${r.rot})`}>
        <span class="review__stars" aria-label="5 étoiles sur 5">★★★★★</span>
        <blockquote class="review__quote">“{r.quote}”</blockquote>
        <figcaption class="review__author">
          <span class="review__avatar" aria-hidden="true">{r.initials}</span>
          <span style="display:flex;flex-direction:column">
            <strong style="font-size:15px">{r.name}</strong>
            <span style="font-size:13.5px">{r.role}</span>
          </span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .reviews { padding-top: 96px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 40px; }
  .reviews__score { display: flex; flex-direction: column; align-items: flex-end; }
  .reviews__count { font-size: 14px; color: var(--muted); }
  .review { margin: 0; padding: 26px; display: flex; flex-direction: column; gap: 18px; }
  .review__stars { font-size: 18px; letter-spacing: 2px; }
  .review__quote { margin: 0; font-size: 18px; line-height: 1.45; font-weight: 500; text-wrap: pretty; }
  .review__author { display: flex; align-items: center; gap: 12px; margin-top: auto; }
  .review__avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: var(--border);
    background: #fff;
    display: grid;
    place-items: center;
    font-weight: 800;
  }
</style>
