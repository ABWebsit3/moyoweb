---
import { clients } from '../data/site';
// Wordmarks texte en attendant les vrais logos clients.
---

<section class="container logos" aria-label="Ils nous font confiance" data-reveal-stagger>
  <span class="logos__kicker">Ils ont sauté le pas</span>
  {clients.map((name) => <span class="logos__item">{name}</span>)}
</section>

<style>
  .logos {
    padding-top: 40px;
    padding-bottom: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    align-items: center;
    justify-content: center;
  }
  .logos__kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .logos__item { font-family: var(--font-display); font-weight: 800; font-size: 22px; color: var(--logo-grey); }
</style>
