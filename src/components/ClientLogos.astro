---
// ⚠ Wordmarks texte provisoires : à remplacer par les vrais logos clients.
---

<section class="container logos" aria-label="Ils nous font confiance">
  <span class="logos__kicker">Ils ont sauté le pas</span>
  <span class="logos__item" style="font-family:var(--font-display);font-weight:800">TKL Miami</span>
  <span class="logos__item" style="font-family:var(--font-display);font-weight:600">Lucas Invest Immo</span>
  <span class="logos__item" style="font-family:Georgia,serif;font-style:italic">Atelier Brume</span>
  <span class="logos__item" style="font-family:var(--font-display);font-weight:800;letter-spacing:.1em">KAYA</span>
  <span class="logos__item" style="font-family:var(--font-mono);font-weight:700;font-size:19px">café.sillon</span>
</section>

<style>
  .logos {
    padding-top: 40px;
    padding-bottom: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    align-items: center;
    justify-content: center;
  }
  .logos__kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .logos__item { font-size: 22px; color: var(--logo-grey); }
</style>
