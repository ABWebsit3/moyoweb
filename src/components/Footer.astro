---
import { Image } from 'astro:assets';
import { IMAGES } from '../data/site';
---

<footer class="footer">
  <div class="container footer__inner">
    <a href="/"><Image src={IMAGES.logo} alt="Moyo" width={150} class="footer__logo" /></a>
    <nav class="footer__links" aria-label="Liens légaux">
      <a href="/mentions-legales/">Mentions légales</a>
      <a href="/cgv/">CGV</a>
      <a href="/confidentialite/">Confidentialité</a>
      <a href="/resiliation/">Résilier ton contrat</a>
      <button type="button" class="footer__cookies" data-cookie-panel>Gestion des cookies</button>
    </nav>
    <span>© {new Date().getFullYear()} Moyo</span>
  </div>
</footer>

<script>
  document.querySelector('[data-cookie-panel]')?.addEventListener('click', () => {
    (window as any).tarteaucitron?.userInterface?.openPanel();
  });
</script>

<style>
  .footer { border-top: var(--border); }
  .footer__inner {
    padding-top: 32px;
    padding-bottom: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--text-2);
  }
  .footer__inner :global(.footer__logo) { height: 22px; width: auto; display: block; }
  .footer__links { display: flex; gap: 20px; flex-wrap: wrap; align-items: center; }
  .footer__links a, .footer__cookies { color: var(--text-2); }
  .footer__cookies {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .footer__cookies:hover { color: var(--ink); }
</style>
