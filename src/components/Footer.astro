---
import { Image } from 'astro:assets';
import { IMAGES } from '../data/site';
// TODO : brancher les pages légales (mentions légales, CGV, confidentialité).
---

<footer class="footer">
  <div class="container footer__inner">
    <Image src={IMAGES.logo} alt="Moyo" width={150} class="footer__logo" />
    <nav class="footer__links" aria-label="Liens légaux">
      <a href="#">Mentions légales</a>
      <a href="#">CGV</a>
      <a href="#">Confidentialité</a>
    </nav>
    <span>© {new Date().getFullYear()} Moyo</span>
  </div>
</footer>

<style>
  .footer { border-top: var(--border); }
  .footer__inner {
    padding-top: 32px;
    padding-bottom: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--text-2);
  }
  .footer__inner :global(.footer__logo) { height: 22px; width: auto; }
  .footer__links { display: flex; gap: 20px; flex-wrap: wrap; }
  .footer__links a { color: var(--text-2); }
</style>
