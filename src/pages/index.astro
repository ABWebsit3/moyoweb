---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import KeyFigures from '../components/KeyFigures.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Concept from '../components/Concept.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Techno from '../components/Techno.astro';
import Projects from '../components/Projects.astro';
import Devis from '../components/Devis.astro';
import Offer from '../components/Offer.astro';
import Guarantees from '../components/Guarantees.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { SHOW_REVIEWS } from '../data/site';
---

<Layout
  title="Moyo · Ton site pro en ligne en 3 à 5 jours, dès 44,99 €/mois"
  description="Moyo crée ton site web clé en main, hébergé, sécurisé et mis à jour pour une petite mensualité. Avec ou sans engagement. Calcule ton devis en 2 minutes."
>
  <Header />
  <main>
    <Hero />
    <KeyFigures />
    <ClientLogos />
    <Concept />
    <HowItWorks />
    <Techno />
    <Projects />
    <Devis />
    <Offer />
    <Guarantees />
    {SHOW_REVIEWS && <Reviews />}
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Layout>
