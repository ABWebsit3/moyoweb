# Copier en .env pour le développement local (ne jamais committer .env).
# En production : variables d'environnement de l'application Node.js Hostinger.

# Dolibarr (obligatoire pour le devis, la résiliation et le questionnaire)
DOLIBARR_API_KEY=
DOLIBARR_API_URL=https://doli.agence-abweb.fr/htdocs/api/index.php
# Facultatif : id de l'utilisateur Dolibarr propriétaire des événements Agenda
DOLIBARR_USER_ID=

# E-mails (SMTP Hostinger, boîte hello@moyoweb.fr)
SMTP_PASSWORD=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@moyoweb.fr

# Adresse publique du site (liens envoyés par e-mail)
PUBLIC_SITE_URL=https://moyoweb.fr

# Google Analytics 4 (lu au build ; active le bandeau cookies)
PUBLIC_GA4_ID=
